# ============================================================
# Central server environment  (logbase + LLM query side)
# Copy to .env and adjust paths as needed.
# ============================================================

# Mosquitto broker runs locally on this machine
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Path to the SQLite logbase written by the subscriber
# and read by the LLM query pipeline
LOGBASE_PATH=/opt/vforensiq/runtime/vforensiq_logbase.db

# OpenAI key for LLM workstreams (B1 / B2 / AQR)
OPENAI_API_KEY=sk-...
