      "type": "cypher_query",
      "cypher": "MATCH (e:Event)-[:DETECTED_BY]->(c:Camera {camera_location: 'KeynoteHall_DoorA'})-[:LOCATED_AT]->(:Location {name: 'KeynoteHall_DoorA'})\nWHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\nRETURN 'entry_patterns' AS aspect, e.timestamp_utc AS time, e.event_type AS type, COUNT(e) AS count, NULL AS avg_head_count, NULL AS peak_head_count\nUNION\nMATCH (ch:CrowdHour {camera_location: 'KeynoteHall_Stage'})-[:DURING]->(h:Hour)\nWHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\nRETURN 'crowd_density' AS aspect, ch.hour_utc AS time, NULL AS type, NULL AS count, ch.avg_hc AS avg_head_count, ch.peak_hc AS peak_head_count\nUNION\nMATCH (e:Event)-[:DETECTED_BY]->(c:Camera {camera_location: 'KeynoteHall_DoorA'})-[:LOCATED_AT]->(:Location {name: 'KeynoteHall_DoorA'})\nWHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\nRETURN 'dispersal_vs_build_up' AS aspect, e.timestamp_utc AS time, e.event_type AS type, COUNT(e) AS count, NULL AS avg_head_count, NULL AS peak_head_count",
