      "cypher": "MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\nWHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\nRETURN l.name AS location, ch.hour_utc AS hour, ch.avg_hc AS average_head_count, ch.peak_hc AS peak_head_count, ch.event_count AS event_count, 'crowd' AS data_type\nORDER BY ch.peak_hc DESC, ch.avg_hc DESC\n\nUNION\n\nMATCH (e:Event)-[:DETECTED_BY]->(c:Camera)-[:LOCATED_AT]->(l:Location)\nWHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\nRETURN l.name AS location, e.timestamp_utc AS hour, NULL AS average_head_count, NULL AS peak_head_count, COUNT(e) AS event_count, 'event' AS data_type\nORDER BY event_count DESC",
