  "citations": [
    {
      "type": "cypher_query",
      "cypher": "MATCH (n:CrowdHour {camera_location: 'DemoBooth_NVIDIA'})-[:DURING]->(h:Hour)\nWHERE h.hour_utc >= '2025-12-08T00:00:00Z' AND h.hour_utc < '2025-12-09T00:00:00Z'\nWITH n.avg_hc AS avg_nvidia, n.peak_hc AS peak_nvidia, n.event_count AS count_nvidia\nMATCH (i:CrowdHour {camera_location: 'DemoBooth_Intel'})-[:DURING]->(h)\nWHERE h.hour_utc >= '2025-12-08T00:00:00Z' AND h.hour_utc < '2025-12-09T00:00:00Z'\nWITH avg_nvidia, peak_nvidia, count_nvidia, i.avg_hc AS avg_intel, i.peak_hc AS peak_intel, i.event_count AS count_intel\nRETURN \n  CASE \n    WHEN peak_nvidia > peak_intel THEN 'NVIDIA' \n    ELSE 'Intel' \n  END AS winner,\n  ABS(peak_nvidia - peak_intel) AS popularity_difference,\n  peak_nvidia AS nvidia_peak, \n  peak_intel AS intel_peak",
      "row_count": 576
    }
