      "type": "cypher_query",
      "cypher": "MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)-[:LOCATED_AT]->(l:Location)\nWHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\nWITH l.name AS location, c.camera_location AS camera_location, e.event_type AS event_type, COUNT(e) AS event_count\nRETURN location, camera_location, event_type, event_count, null AS peak_head_count, null AS time\nORDER BY event_count DESC\n\nUNION\n\nMATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\nWHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\nRETURN l.name AS location, c.camera_location AS camera_location, null AS event_type, null AS event_count, ch.peak_hc AS peak_head_count, ch.hour_utc AS time\nORDER BY peak_head_count DESC",
