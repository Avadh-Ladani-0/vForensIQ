      "type": "cypher_query",
      "cypher": "CALL {\n  // Busiest traffic windows at the main gates\n  MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE l.name CONTAINS 'MainEntrance' AND e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(e) AS event_count\n  RETURN 'main_gate_traffic' AS category, hour, event_count\n  UNION ALL\n  // Keynote hall attendance peaks\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE l.name CONTAINS 'KeynoteHall' AND ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'keynote_hall' AS category, ch.hour_utc AS hour, ch.peak_hc AS event_count\n  UNION ALL\n  // Lunchtime dynamics at the food court\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE l.name CONTAINS 'FoodCourt' AND ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'food_court' AS category, ch.hour_utc AS hour, ch.avg_hc AS event_count\n  UNION ALL\n  // Demo booths comparison: NVIDIA\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE l.name CONTAINS 'NVIDIA' AND ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'nvidia_booth' AS category, ch.hour_utc AS hour, ch.avg_hc AS event_count\n  UNION ALL\n  // Demo booths comparison: Intel\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE l.name CONTAINS 'Intel' AND ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'intel_booth' AS category, ch.hour_utc AS hour, ch.avg_hc AS event_count\n}\nRETURN category, hour, event_count ORDER BY category, hour",
      "row_count": 120
    }
