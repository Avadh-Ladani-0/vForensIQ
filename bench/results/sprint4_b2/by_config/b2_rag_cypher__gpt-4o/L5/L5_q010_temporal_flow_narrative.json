      "type": "cypher_query",
      "cypher": "CALL {\n  MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n    AND e.event_type IN ['person_entry', 'person_exit']\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, l.name AS location, count(*) AS n\n  RETURN hour, location, n\n  UNION ALL\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)-[:LOCATED_AT]->(l:Location)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN ch.hour_utc AS hour, l.name AS location, sum(ch.event_count) AS n\n}\nRETURN hour, location, sum(n) AS count ORDER BY hour, location",
