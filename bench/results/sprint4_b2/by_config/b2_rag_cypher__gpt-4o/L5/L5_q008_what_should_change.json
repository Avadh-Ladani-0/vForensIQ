  "citations": [
    {
      "type": "cypher_query",
      "cypher": "CALL {\n  // Get total events by type including crowd\n  MATCH (e:Event)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  RETURN 'event_type' AS category, e.event_type AS detail, count(*) AS count\n  UNION ALL\n  MATCH (ch:CrowdHour)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'event_type' AS category, 'crowd' AS detail, sum(ch.event_count) AS count\n  UNION ALL\n  // Get hourly breakdown of all events\n  MATCH (e:Event)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN 'hourly_breakdown' AS category, hour AS detail, n AS count\n  UNION ALL\n  MATCH (ch:CrowdHour)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'hourly_breakdown' AS category, ch.hour_utc AS detail, ch.event_count AS count\n  UNION ALL\n  // Get crowd statistics at NVIDIA booth\n  MATCH (ch:CrowdHour {camera_location: 'DemoBooth_NVIDIA'})\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'location_stats' AS category, 'NVIDIA Booth' AS detail, avg(ch.avg_hc) AS count\n  UNION ALL\n  MATCH (ch:CrowdHour {camera_location: 'DemoBooth_NVIDIA'})\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'location_stats' AS category, 'NVIDIA Booth Peak' AS detail, max(ch.peak_hc) AS count\n  UNION ALL\n  // Get crowd statistics at Main Entrance\n  MATCH (ch:CrowdHour {camera_location: 'Gate_MainEntrance'})\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'location_stats' AS category, 'Main Entrance' AS detail, avg(ch.avg_hc) AS count\n  UNION ALL\n  MATCH (ch:CrowdHour {camera_location: 'Gate_MainEntrance'})\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'location_stats' AS category, 'Main Entrance Peak' AS detail, max(ch.peak_hc) AS count\n  UNION ALL\n  // Count distinct active cameras\n  CALL {\n    MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)\n    WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n    RETURN c.camera_id AS cid\n    UNION\n    MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)\n    WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n    RETURN c.camera_id AS cid\n  }\n  RETURN 'active_cameras' AS category, 'Active Cameras' AS detail, count(DISTINCT cid) AS count\n}\nRETURN category, detail, count ORDER BY category, detail",
      "row_count": 152
    }
