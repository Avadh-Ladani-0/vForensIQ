    {
      "type": "cypher_query",
      "cypher": "CALL {\n  MATCH (e:Event)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN hour, n, null AS location, null AS avg_head_count, null AS peak_head_count, null AS event_type\n  UNION ALL\n  MATCH (ch:CrowdHour)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN ch.hour_utc AS hour, ch.event_count AS n, ch.camera_location AS location, ch.avg_hc AS avg_head_count, ch.peak_hc AS peak_head_count, 'crowd' AS event_type\n}\nRETURN hour, sum(n) AS total_events, location, avg(avg_head_count) AS avg_head_count, max(peak_head_count) AS peak_head_count, event_type\nORDER BY hour, peak_head_count DESC, total_events DESC",
      "row_count": 144
    }
