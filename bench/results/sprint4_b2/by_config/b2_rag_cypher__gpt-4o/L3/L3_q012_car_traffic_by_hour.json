      "type": "cypher_query",
      "cypher": "CALL {\n  MATCH (e:Event {event_type: 'car_entry'})-[:DETECTED_BY]->(:Camera {camera_location: 'Parking'})\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN hour, 'car_entry' AS event_type, n\n  UNION ALL\n  MATCH (e:Event {event_type: 'car_exit'})-[:DETECTED_BY]->(:Camera {camera_location: 'Parking'})\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN hour, 'car_exit' AS event_type, n\n}\nRETURN hour, event_type, n ORDER BY hour, event_type",
