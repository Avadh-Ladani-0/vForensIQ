      "type": "cypher_query",
      "cypher": "CALL {\n  MATCH (ch:CrowdHour)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN ch.hour_utc AS hour, ch.camera_location AS location, ch.avg_hc AS avg_crowd\n}\nWITH hour, location, avg_crowd\nORDER BY hour, avg_crowd DESC\nWITH hour, collect({location: location, avg_crowd: avg_crowd}) AS crowds\nRETURN hour, crowds[0].location AS winning_location, crowds[0].avg_crowd AS avg_crowd_per_hour ORDER BY hour",
      "row_count": 24
    }
