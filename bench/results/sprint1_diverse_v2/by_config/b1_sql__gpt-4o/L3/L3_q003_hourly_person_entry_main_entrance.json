  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH HourlyEntries AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour_utc,\n        COUNT(*) AS entry_count\n    FROM \n        events\n    WHERE \n        event_type = 'person_entry' AND\n        camera_location = 'Gate_MainEntrance' AND\n        timestamp_utc >= '2025-12-08T00:00:00Z' AND\n        timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        hour_utc\n)\nSELECT \n    hour_utc,\n    COALESCE(entry_count, 0) AS entry_count\nFROM \n    (SELECT '00' AS hour_utc UNION ALL SELECT '01' UNION ALL SELECT '02' UNION ALL SELECT '03' UNION ALL\n     SELECT '04' UNION ALL SELECT '05' UNION ALL SELECT '06' UNION ALL SELECT '07' UNION ALL\n     SELECT '08' UNION ALL SELECT '09' UNION ALL SELECT '10' UNION ALL SELECT '11' UNION ALL\n     SELECT '12' UNION ALL SELECT '13' UNION ALL SELECT '14' UNION ALL SELECT '15' UNION ALL\n     SELECT '16' UNION ALL SELECT '17' UNION ALL SELECT '18' UNION ALL SELECT '19' UNION ALL\n     SELECT '20' UNION ALL SELECT '21' UNION ALL SELECT '22' UNION ALL SELECT '23') AS hours\nLEFT JOIN \n    HourlyEntries USING (hour_utc)\nORDER BY \n    hour_utc",
      "row_count": 24
    }
