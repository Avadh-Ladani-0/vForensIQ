  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_crowd AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        AVG(head_count) AS avg_crowd_size\n    FROM \n        events\n    WHERE \n        event_type = 'crowd'\n        AND camera_location LIKE '%KeynoteHall_Stage%'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z'\n        AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        hour\n)\nSELECT \n    hour, \n    avg_crowd_size\nFROM \n    hourly_crowd\nORDER BY \n    hour",
      "row_count": 24
    }
