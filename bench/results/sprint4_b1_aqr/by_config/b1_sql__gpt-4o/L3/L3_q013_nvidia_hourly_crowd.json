  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_crowd AS (\n    SELECT\n        strftime('%Y-%m-%dT%H:00:00Z', timestamp_epoch_s, 'unixepoch') AS hour,\n        SUM(head_count) AS total_head_count\n    FROM\n        events\n    WHERE\n        event_type = 'crowd'\n        AND camera_location LIKE '%NVIDIA%'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z'\n        AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY\n        hour\n)\nSELECT * FROM hourly_crowd",
      "row_count": 24
    }
