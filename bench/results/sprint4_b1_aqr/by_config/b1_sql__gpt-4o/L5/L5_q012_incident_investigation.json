  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT \n        MIN(timestamp_epoch_s) AS min_time,\n        MAX(timestamp_epoch_s) AS max_time\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\ncrowd_surge AS (\n    SELECT \n        timestamp_utc,\n        head_count\n    FROM \n        events\n    WHERE \n        camera_location LIKE '%KeynoteHall%' \n        AND event_type = 'crowd'\n        AND strftime('%H', timestamp_epoch_s, 'unixepoch') = '09'\n),\nentry_spikes AS (\n    SELECT \n        camera_location,\n        COUNT(*) AS entry_count\n    FROM \n        events\n    WHERE \n        event_type = 'person_entry'\n        AND timestamp_utc < '2025-12-08T09:00:00Z'\n        AND camera_location LIKE '%MainEntrance%'\n    GROUP BY \n        camera_location\n),\nexit_spikes AS (\n    SELECT \n        camera_location,\n        COUNT(*) AS exit_count\n    FROM \n        events\n    WHERE \n        event_type = 'person_exit'\n        AND timestamp_utc >= '2025-12-08T09:00:00Z'\n    GROUP BY \n        camera_location\n)\nSELECT \n    'Crowd Surge' AS event_type,\n    timestamp_utc,\n    head_count\nFROM \n    crowd_surge\nUNION ALL\nSELECT \n    'Entry Spikes' AS event_type,\n    camera_location,\n    entry_count\nFROM \n    entry_spikes\nUNION ALL\nSELECT \n    'Exit Spikes' AS event_type,\n    camera_location,\n    exit_count\nFROM \n    exit_spikes",
      "row_count": 3604
    }
