  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH event_summary AS (\n    SELECT \n        camera_location,\n        event_type,\n        SUM(CASE WHEN event_type = 'crowd' THEN head_count ELSE 0 END) AS total_head_count,\n        COUNT(*) AS event_count\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        camera_location, event_type\n),\npeak_hours AS (\n    SELECT \n        camera_location,\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        SUM(CASE WHEN event_type = 'crowd' THEN head_count ELSE 0 END) AS hourly_head_count,\n        COUNT(*) AS hourly_event_count\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        camera_location, hour\n)\nSELECT \n    es.camera_location,\n    es.event_type,\n    es.total_head_count,\n    es.event_count,\n    ph.hour,\n    ph.hourly_head_count,\n    ph.hourly_event_count\nFROM \n    event_summary es\nLEFT JOIN \n    peak_hours ph ON es.camera_location = ph.camera_location\nORDER BY \n    es.camera_location, es.event_type, ph.hour",
      "row_count": 360
    }
  ],
