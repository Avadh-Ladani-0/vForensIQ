  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT \n        MIN(timestamp_epoch_s) AS start_time,\n        MAX(timestamp_epoch_s) AS end_time\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\nhourly_flow AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        camera_location,\n        SUM(CASE WHEN event_type = 'person_entry' THEN 1 ELSE 0 END) AS entries,\n        SUM(CASE WHEN event_type = 'person_exit' THEN 1 ELSE 0 END) AS exits,\n        SUM(CASE WHEN event_type = 'crowd' THEN head_count ELSE 0 END) AS crowd_count\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n        AND (camera_location LIKE '%MainEntrance%' OR camera_location LIKE '%ExpoFloor%' \n             OR camera_location LIKE '%KeynoteHall%' OR camera_location LIKE '%FoodCourt%')\n    GROUP BY \n        hour, camera_location\n)\nSELECT \n    hour,\n    camera_location,\n    entries,\n    exits,\n    crowd_count\nFROM \n    hourly_flow\nORDER BY \n    hour, camera_location",
      "row_count": 120
    }
