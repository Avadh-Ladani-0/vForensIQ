      "sql": "WITH departure_events AS (\n    SELECT \n        timestamp_utc,\n        timestamp_epoch_s,\n        camera_location,\n        event_type,\n        object_id,\n        confidence\n    FROM \n        events\n    WHERE \n        event_type IN ('person_exit', 'car_exit')\n        AND timestamp_utc >= '2025-12-08T17:00:00Z'\n        AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\nhourly_departures AS (\n    SELECT\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        camera_location,\n        COUNT(*) AS departure_count\n    FROM \n        departure_events\n    GROUP BY \n        hour, camera_location\n),\npeak_departures AS (\n    SELECT\n        camera_location,\n        MAX(departure_count) AS max_departure_count\n    FROM \n        hourly_departures\n    GROUP BY \n        camera_location\n)\nSELECT \n    d.timestamp_utc,\n    d.camera_location,\n    d.event_type,\n    d.object_id,\n    d.confidence,\n    hd.hour,\n    hd.departure_count,\n    pd.max_departure_count\nFROM \n    departure_events d\nJOIN \n    hourly_departures hd ON d.camera_location = hd.camera_location AND strftime('%H', d.timestamp_epoch_s, 'unixepoch') = hd.hour\nJOIN \n    peak_departures pd ON hd.camera_location = pd.camera_location\nORDER BY \n    d.timestamp_utc",
