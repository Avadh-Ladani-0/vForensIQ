  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT \n        MIN(timestamp_epoch_s) AS start_time,\n        MAX(timestamp_epoch_s) AS end_time\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\ncrowd_events AS (\n    SELECT \n        camera_location,\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        AVG(head_count) AS avg_head_count\n    FROM events\n    WHERE event_type = 'crowd'\n      AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND camera_location LIKE '%DemoBooth%'\n    GROUP BY camera_location, hour\n),\nentry_exit_events AS (\n    SELECT \n        camera_location,\n        event_type,\n        COUNT(*) AS event_count\n    FROM events\n    WHERE event_type IN ('person_entry', 'person_exit')\n      AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND camera_location LIKE '%DemoBooth%'\n    GROUP BY camera_location, event_type\n)\nSELECT \n    'Crowd' AS aspect,\n    camera_location,\n    hour,\n    avg_head_count\nFROM crowd_events\nUNION ALL\nSELECT \n    'Entry/Exit' AS aspect,\n    camera_location,\n    event_type,\n    event_count\nFROM entry_exit_events\nORDER BY camera_location, aspect, hour",
      "row_count": 48
    }
