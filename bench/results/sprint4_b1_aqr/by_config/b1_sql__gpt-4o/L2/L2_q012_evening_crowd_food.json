    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT MIN(timestamp_epoch_s) AS min_time, MAX(timestamp_epoch_s) AS max_time\n    FROM events\n),\ncrowd_events AS (\n    SELECT *\n    FROM events\n    WHERE event_type = 'crowd'\n      AND camera_location LIKE '%FoodCourt%'\n      AND strftime('%H', timestamp_epoch_s, 'unixepoch') BETWEEN '17' AND '18'\n      AND timestamp_utc >= '2025-12-08T00:00:00Z'\n      AND timestamp_utc < '2025-12-09T00:00:00Z'\n)\nSELECT timestamp_utc, camera_id, head_count\nFROM crowd_events\nORDER BY timestamp_utc",
      "row_count": 7200
    }
