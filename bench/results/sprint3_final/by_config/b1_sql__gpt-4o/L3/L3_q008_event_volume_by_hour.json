  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT MIN(timestamp_epoch_s) AS min_time, MAX(timestamp_epoch_s) AS max_time\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n)\nSELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour, COUNT(*) AS total_events\nFROM events\nWHERE timestamp_epoch_s BETWEEN (SELECT min_time FROM time_bounds) AND (SELECT max_time FROM time_bounds)\nGROUP BY hour\nORDER BY hour",
      "row_count": 24
    }
