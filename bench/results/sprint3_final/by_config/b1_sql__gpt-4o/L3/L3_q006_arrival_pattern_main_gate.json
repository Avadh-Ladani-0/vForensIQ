  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_arrivals AS (\n    SELECT\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        COUNT(*) AS arrival_count\n    FROM\n        events\n    WHERE\n        event_type = 'person_entry'\n        AND camera_location LIKE '%MainEntrance%'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z'\n        AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY\n        hour\n)\nSELECT * FROM hourly_arrivals",
