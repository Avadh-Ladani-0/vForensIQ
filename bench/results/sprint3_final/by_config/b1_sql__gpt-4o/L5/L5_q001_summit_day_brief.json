  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT \n        MIN(timestamp_epoch_s) AS min_time,\n        MAX(timestamp_epoch_s) AS max_time\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\nmain_gate_traffic AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        COUNT(*) AS event_count\n    FROM \n        events\n    WHERE \n        camera_location LIKE '%MainEntrance%' \n        AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        hour\n),\nkeynote_hall_peaks AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        MAX(head_count) AS max_head_count\n    FROM \n        events\n    WHERE \n        camera_location LIKE '%KeynoteHall%' \n        AND event_type = 'crowd'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        hour\n),\nfood_court_dynamics AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        MAX(head_count) AS max_head_count\n    FROM \n        events\n    WHERE \n        camera_location LIKE '%FoodCourt%' \n        AND event_type = 'crowd'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        hour\n),\ndemo_booth_comparison AS (\n    SELECT \n        camera_location,\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        MAX(head_count) AS max_head_count\n    FROM \n        events\n    WHERE \n        (camera_location LIKE '%NVIDIA%' OR camera_location LIKE '%Intel%')\n        AND event_type = 'crowd'\n        AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY \n        camera_location, hour\n)\nSELECT \n    'Main Gate Traffic' AS category, hour, event_count AS metric\nFROM \n    main_gate_traffic\nUNION ALL\nSELECT \n    'Keynote Hall Peaks' AS category, hour, max_head_count AS metric\nFROM \n    keynote_hall_peaks\nUNION ALL\nSELECT \n    'Food Court Dynamics' AS category, hour, max_head_count AS metric\nFROM \n    food_court_dynamics\nUNION ALL\nSELECT \n    'Demo Booth Comparison' AS category, camera_location || ' ' || hour, max_head_count AS metric\nFROM \n    demo_booth_comparison",
      "row_count": 120
    }
