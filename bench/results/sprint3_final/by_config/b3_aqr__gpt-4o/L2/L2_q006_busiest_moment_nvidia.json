      "type": "sql_query",
      "sql": "WITH event_window AS (\n    SELECT *\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND camera_location LIKE '%NVIDIA%'\n      AND event_type = 'crowd'\n),\npeak_moment AS (\n    SELECT MAX(head_count) AS max_head_count\n    FROM event_window\n)\nSELECT e.*\nFROM event_window e\nJOIN peak_moment pm ON e.head_count = pm.max_head_count",
