      "cypher": "CALL {\n  MATCH (e:Event)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n, null AS event_type, null AS location, null AS avg_head_count, null AS peak_head_count\n  RETURN hour, n, event_type, location, avg_head_count, peak_head_count\n  UNION ALL\n  MATCH (ch:CrowdHour)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN ch.hour_utc AS hour, ch.event_count AS n, 'crowd' AS event_type, ch.camera_location AS location, avg(ch.avg_hc) AS avg_head_count, max(ch.peak_hc) AS peak_head_count\n}\nRETURN hour, sum(n) AS total_events, event_type, location, avg_head_count, peak_head_count\nORDER BY hour, total_events DESC, peak_head_count DESC",
