    {
      "type": "cypher_query",
      "cypher": "CALL {\n  // (a) Door entry patterns at KeynoteHall_DoorA throughout the day\n  MATCH (e:Event {event_type: 'person_entry'})-[:DETECTED_BY]->(:Camera {camera_location: 'KeynoteHall_DoorA'})\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN 'entry_patterns' AS aspect, hour, n\n  UNION ALL\n  // (b) In-hall crowd density at KeynoteHall_Stage during keynote sessions\n  MATCH (ch:CrowdHour {camera_location: 'KeynoteHall_Stage'})\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN 'crowd_density' AS aspect, ch.hour_utc AS hour, ch.avg_hc AS n\n  UNION ALL\n  // (c) Post-keynote dispersal vs pre-keynote build-up\n  MATCH (e:Event {event_type: 'person_exit'})-[:DETECTED_BY]->(:Camera {camera_location: 'KeynoteHall_DoorA'})\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN 'dispersal_patterns' AS aspect, hour, n\n}\nRETURN aspect, hour, n ORDER BY aspect, hour",
      "row_count": 62
    }
