      "type": "cypher_query",
      "cypher": "CALL {\n  // Busiest traffic windows at the main gates\n  MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)\n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n    AND c.camera_location CONTAINS 'MainEntrance'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS n\n  RETURN 'main_gate_traffic' AS category, hour, n\n  UNION ALL\n  // Keynote hall attendance peaks\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n    AND c.camera_location CONTAINS 'KeynoteHall'\n  RETURN 'keynote_hall' AS category, ch.hour_utc AS hour, ch.peak_hc AS n\n  UNION ALL\n  // Lunchtime dynamics at the food court\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n    AND c.camera_location CONTAINS 'FoodCourt'\n  RETURN 'food_court' AS category, ch.hour_utc AS hour, ch.avg_hc AS n\n  UNION ALL\n  // Demo booths comparison: NVIDIA\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n    AND c.camera_location CONTAINS 'NVIDIA'\n  RETURN 'demo_booth_nvidia' AS category, ch.hour_utc AS hour, ch.avg_hc AS n\n  UNION ALL\n  // Demo booths comparison: Intel\n  MATCH (ch:CrowdHour)-[:AT_CAMERA]->(c:Camera)\n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n    AND c.camera_location CONTAINS 'Intel'\n  RETURN 'demo_booth_intel' AS category, ch.hour_utc AS hour, ch.avg_hc AS n\n}\nRETURN category, hour, n ORDER BY category, n DESC, hour",
      "row_count": 120
    }
