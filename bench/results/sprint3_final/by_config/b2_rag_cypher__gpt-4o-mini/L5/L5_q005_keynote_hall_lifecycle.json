    {
      "type": "cypher_query",
      "cypher": "CALL {\n  MATCH (e:Event)-[:DETECTED_BY]->(c:Camera {camera_location: 'KeynoteHall_DoorA'}) \n  WHERE e.timestamp_utc >= '2025-12-08T00:00:00Z' AND e.timestamp_utc < '2025-12-09T00:00:00Z'\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS entry_count\n  RETURN hour, entry_count\n}\nWITH collect({hour: hour, entry_count: entry_count}) AS door_entries\nCALL {\n  MATCH (ch:CrowdHour {camera_location: 'KeynoteHall_Stage'}) \n  WHERE ch.hour_utc >= '2025-12-08T00:00:00Z' AND ch.hour_utc < '2025-12-09T00:00:00Z'\n  RETURN ch.hour_utc AS hour, ch.avg_hc AS avg_head_count, ch.peak_hc AS peak_head_count\n}\nWITH door_entries, collect({hour: hour, avg_head_count: avg_head_count, peak_head_count: peak_head_count}) AS crowd_data\nRETURN door_entries, crowd_data",
      "row_count": 1
    }
