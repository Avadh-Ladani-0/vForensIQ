      "cypher": "MATCH (e:Event)-[:DETECTED_BY]->(c:Camera)\nWHERE e.event_type = 'person_entry'\n  AND e.timestamp_utc >= '2025-12-08T00:00:00Z'\n  AND e.timestamp_utc <  '2025-12-09T00:00:00Z'\n  AND c.camera_location CONTAINS 'MainEntrance'\nWITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour, count(*) AS arrivals\nRETURN hour, arrivals\nORDER BY hour",
