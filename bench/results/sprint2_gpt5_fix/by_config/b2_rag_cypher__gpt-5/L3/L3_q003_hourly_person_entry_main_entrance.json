  "citations": [
    {
      "type": "cypher_query",
      "cypher": "WITH '2025-12-08T00:00:00Z' AS dayStart, '2025-12-09T00:00:00Z' AS dayEnd\nCALL {\n  WITH dayStart, dayEnd\n  MATCH (e:Event {event_type: 'person_entry'})-[:DETECTED_BY]->(c:Camera {camera_location: 'Gate_MainEntrance'})\n  WHERE e.timestamp_utc >= dayStart AND e.timestamp_utc < dayEnd\n  WITH substring(e.timestamp_utc, 0, 13) + ':00:00Z' AS hour\n  WITH hour, count(*) AS cnt\n  RETURN collect({hour: hour, cnt: cnt}) AS counts\n}\nUNWIND range(0,23) AS h\nWITH substring(dayStart, 0, 10) AS d, h, counts\nWITH d + 'T' + CASE WHEN h < 10 THEN '0' + toString(h) ELSE toString(h) END + ':00:00Z' AS hour_utc, counts\nWITH hour_utc, coalesce(head([x IN counts WHERE x.hour = hour_utc | x.cnt]), 0) AS count\nRETURN hour_utc, count\nORDER BY hour_utc",
      "row_count": 24
    }
