  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH keynote_events AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        SUM(head_count) AS total_head_count\n    FROM events\n    WHERE camera_location LIKE '%KeynoteHall_Stage%'\n      AND timestamp_utc >= '2025-12-08T00:00:00Z' \n      AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND event_type = 'crowd'\n    GROUP BY hour\n)\nSELECT hour, total_head_count FROM keynote_events ORDER BY hour",
