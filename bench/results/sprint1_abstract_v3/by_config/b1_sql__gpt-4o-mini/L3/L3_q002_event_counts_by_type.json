      "type": "sql_query",
      "sql": "WITH event_counts AS (\n    SELECT event_type, COUNT(*) AS count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY event_type\n)\nSELECT event_type, count FROM event_counts",
