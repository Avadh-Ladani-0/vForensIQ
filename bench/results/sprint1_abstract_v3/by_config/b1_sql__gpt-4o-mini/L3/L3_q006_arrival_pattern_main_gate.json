  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH arrivals AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS arrival_count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' \n      AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND event_type = 'person_entry'\n      AND camera_location LIKE '%MainEntrance%'\n    GROUP BY hour\n)\nSELECT hour, arrival_count\nFROM arrivals\nORDER BY hour",
