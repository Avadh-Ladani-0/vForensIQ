  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_counts AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS entry_count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' \n      AND timestamp_utc < '2025-12-09T00:00:00Z'\n      AND event_type = 'person_entry'\n      AND camera_location LIKE '%MainEntrance%'\n    GROUP BY hour\n)\nSELECT hours.hour, COALESCE(entry_count, 0) AS entry_count\nFROM (SELECT '00' AS hour UNION ALL SELECT '01' UNION ALL SELECT '02' UNION ALL SELECT '03' UNION ALL \n      SELECT '04' UNION ALL SELECT '05' UNION ALL SELECT '06' UNION ALL SELECT '07' UNION ALL \n      SELECT '08' UNION ALL SELECT '09' UNION ALL SELECT '10' UNION ALL SELECT '11' UNION ALL \n      SELECT '12' UNION ALL SELECT '13' UNION ALL SELECT '14' UNION ALL SELECT '15' UNION ALL \n      SELECT '16' UNION ALL SELECT '17' UNION ALL SELECT '18' UNION ALL SELECT '19' UNION ALL \n      SELECT '20' UNION ALL SELECT '21' UNION ALL SELECT '22' UNION ALL SELECT '23') AS hours\nLEFT JOIN hourly_counts ON hours.hour = hourly_counts.hour\nORDER BY hours.hour",
      "row_count": 24
    }
