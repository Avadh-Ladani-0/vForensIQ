  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_activity AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           camera_location,\n           COUNT(*) AS event_count,\n           SUM(head_count) AS total_head_count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY hour, camera_location\n),\npeak_hours AS (\n    SELECT hour, camera_location, event_count, total_head_count,\n           RANK() OVER (PARTITION BY camera_location ORDER BY event_count DESC) AS event_rank,\n           RANK() OVER (PARTITION BY camera_location ORDER BY total_head_count DESC) AS head_count_rank\n    FROM hourly_activity\n)\nSELECT hour, camera_location, event_count, total_head_count\nFROM peak_hours\nWHERE event_rank = 1 OR head_count_rank = 1\nORDER BY camera_location, hour",
      "row_count": 192
    }
  ],
