  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT \n        MIN(timestamp_epoch_s) AS start_time,\n        MAX(timestamp_epoch_s) AS end_time\n    FROM \n        events\n    WHERE \n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n),\nhourly_activity AS (\n    SELECT\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        camera_location,\n        event_type,\n        COUNT(*) AS event_count,\n        SUM(head_count) AS total_head_count\n    FROM\n        events\n    WHERE\n        timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY\n        hour, camera_location, event_type\n),\npeak_hours AS (\n    SELECT\n        hour,\n        camera_location,\n        SUM(event_count) AS total_events,\n        SUM(total_head_count) AS total_heads\n    FROM\n        hourly_activity\n    GROUP BY\n        hour, camera_location\n    ORDER BY\n        total_events DESC, total_heads DESC\n    LIMIT 3\n)\nSELECT\n    ha.hour,\n    ha.camera_location,\n    ha.event_type,\n    ha.event_count,\n    ha.total_head_count,\n    ph.total_events AS peak_hour_events,\n    ph.total_heads AS peak_hour_heads\nFROM\n    hourly_activity ha\nLEFT JOIN\n    peak_hours ph ON ha.hour = ph.hour AND ha.camera_location = ph.camera_location\nORDER BY\n    ha.hour, ha.camera_location, ha.event_type",
      "row_count": 324
    }
