      "type": "sql_query",
      "sql": "WITH hourly_events AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour, COUNT(*) AS total_events\n    FROM events\n    GROUP BY hour\n)\nSELECT hour, total_events\nFROM hourly_events\nORDER BY hour",
