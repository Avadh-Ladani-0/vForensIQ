    {
      "type": "sql_query",
      "sql": "WITH event_data AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS event_count\n    FROM events\n    WHERE event_type = 'person_entry' AND camera_location LIKE '%MainEntrance%'\n    GROUP BY hour\n)\nSELECT hour, event_count\nFROM event_data\nORDER BY hour",
