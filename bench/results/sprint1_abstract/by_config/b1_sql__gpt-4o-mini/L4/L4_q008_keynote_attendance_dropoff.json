  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH keynote_events AS (\n    SELECT \n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        SUM(head_count) AS total_head_count\n    FROM events\n    WHERE camera_location LIKE '%KeynoteHall_Stage%'\n    GROUP BY hour\n)\nSELECT \n    hour,\n    total_head_count\nFROM keynote_events\nORDER BY hour",
