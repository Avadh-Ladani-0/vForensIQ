  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH event_counts AS (\n    SELECT camera_location, strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour, COUNT(*) AS event_count\n    FROM events\n    WHERE event_type IN ('person_entry', 'person_exit', 'car_entry', 'car_exit')\n    GROUP BY camera_location, hour\n),\ncrowd_counts AS (\n    SELECT camera_location, strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour, SUM(head_count) AS total_head_count\n    FROM events\n    WHERE event_type = 'crowd'\n    GROUP BY camera_location, hour\n)\nSELECT camera_location, hour, event_count, 0 AS total_head_count\nFROM event_counts\nUNION ALL\nSELECT camera_location, hour, 0 AS event_count, total_head_count\nFROM crowd_counts\nORDER BY camera_location, hour",
      "row_count": 240
    }
