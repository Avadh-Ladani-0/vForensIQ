  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH time_bounds AS (\n    SELECT MIN(timestamp_epoch_s) AS min_time, MAX(timestamp_epoch_s) AS max_time FROM events\n),\nhourly_activity AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS event_count,\n           SUM(head_count) AS total_head_count,\n           camera_location\n    FROM events\n    GROUP BY hour, camera_location\n),\npeak_hours AS (\n    SELECT hour, SUM(event_count) AS total_events\n    FROM hourly_activity\n    GROUP BY hour\n    ORDER BY total_events DESC\n    LIMIT 3\n)\nSELECT 'Peak Hours' AS report_type, hour, total_events FROM peak_hours\nUNION ALL\nSELECT 'Crowd Activity', hour, total_head_count FROM hourly_activity WHERE total_head_count > 0\nORDER BY report_type, hour",
      "row_count": 147
    }
