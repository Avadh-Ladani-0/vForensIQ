  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH main_gate_events AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS event_count\n    FROM events\n    WHERE camera_location LIKE '%MainEntrance%'\n    GROUP BY hour\n),\nkeynote_hall_events AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           SUM(head_count) AS total_attendance\n    FROM events\n    WHERE camera_location LIKE '%KeynoteHall%'\n    AND event_type = 'crowd'\n    GROUP BY hour\n),\nfood_court_events AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           SUM(head_count) AS total_lunch_crowd\n    FROM events\n    WHERE camera_location LIKE '%FoodCourt%'\n    AND event_type = 'crowd'\n    GROUP BY hour\n),\ndemo_booth_events AS (\n    SELECT camera_location,\n           SUM(head_count) AS total_crowd\n    FROM events\n    WHERE camera_location LIKE '%NVIDIA%' OR camera_location LIKE '%Intel%'\n    AND event_type = 'crowd'\n    GROUP BY camera_location\n)\nSELECT 'Main Gate Traffic' AS aspect, hour, event_count FROM main_gate_events\nUNION ALL\nSELECT 'Keynote Hall Attendance' AS aspect, hour, total_attendance FROM keynote_hall_events\nUNION ALL\nSELECT 'Food Court Lunchtime Dynamics' AS aspect, hour, total_lunch_crowd FROM food_court_events\nUNION ALL\nSELECT 'Demo Booth Crowd Activity', camera_location, total_crowd FROM demo_booth_events",
      "row_count": 74
    }
