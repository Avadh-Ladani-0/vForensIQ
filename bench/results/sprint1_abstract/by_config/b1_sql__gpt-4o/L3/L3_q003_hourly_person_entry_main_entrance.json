  "citations": [
    {
      "type": "sql_query",
      "sql": "SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS utc_hour,\n       COUNT(*) AS person_entry_count\nFROM events\nWHERE event_type = 'person_entry'\n  AND camera_location LIKE '%MainEntrance%'\n  AND timestamp_utc >= '2025-12-08T00:00:00Z'\n  AND timestamp_utc < '2025-12-09T00:00:00Z'\nGROUP BY utc_hour\nORDER BY utc_hour",
