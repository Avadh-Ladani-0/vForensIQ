  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_activity AS (\n  SELECT \n    strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n    camera_location,\n    SUM(CASE WHEN event_type = 'crowd' THEN head_count ELSE 0 END) AS total_head_count,\n    COUNT(*) AS event_count\n  FROM events\n  WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n  GROUP BY hour, camera_location\n),\nbusiest_hours AS (\n  SELECT \n    hour,\n    camera_location,\n    total_head_count,\n    event_count\n  FROM hourly_activity\n  WHERE total_head_count > (SELECT AVG(total_head_count) FROM hourly_activity) OR event_count > (SELECT AVG(event_count) FROM hourly_activity)\n),\nquiet_hours AS (\n  SELECT \n    hour,\n    camera_location,\n    total_head_count,\n    event_count\n  FROM hourly_activity\n  WHERE total_head_count <= (SELECT AVG(total_head_count) FROM hourly_activity) AND event_count <= (SELECT AVG(event_count) FROM hourly_activity)\n)\nSELECT * FROM busiest_hours\nUNION ALL\nSELECT * FROM quiet_hours",
      "row_count": 192
    }
