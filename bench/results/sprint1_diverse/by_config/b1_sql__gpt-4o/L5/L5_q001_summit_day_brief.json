  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH hourly_traffic AS (\n  SELECT \n    strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n    camera_location,\n    SUM(head_count) AS total_head_count\n  FROM events\n  WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    AND event_type = 'crowd'\n  GROUP BY hour, camera_location\n),\nmain_gate_traffic AS (\n  SELECT \n    hour,\n    SUM(total_head_count) AS main_gate_head_count\n  FROM hourly_traffic\n  WHERE camera_location LIKE 'Gate_MainEntrance%'\n  GROUP BY hour\n),\nkeynote_hall_traffic AS (\n  SELECT \n    hour,\n    SUM(total_head_count) AS keynote_hall_head_count\n  FROM hourly_traffic\n  WHERE camera_location = 'KeynoteHall_Stage'\n  GROUP BY hour\n),\nfood_court_traffic AS (\n  SELECT \n    hour,\n    SUM(total_head_count) AS food_court_head_count\n  FROM hourly_traffic\n  WHERE camera_location LIKE 'FoodCourt%'\n  GROUP BY hour\n),\ndemo_booth_traffic AS (\n  SELECT \n    hour,\n    camera_location,\n    SUM(total_head_count) AS demo_booth_head_count\n  FROM hourly_traffic\n  WHERE camera_location IN ('DemoBooth_NVIDIA', 'DemoBooth_Intel')\n  GROUP BY hour, camera_location\n)\nSELECT \n  'Main Gate' AS category, hour, main_gate_head_count AS head_count\nFROM main_gate_traffic\nUNION ALL\nSELECT \n  'Keynote Hall' AS category, hour, keynote_hall_head_count AS head_count\nFROM keynote_hall_traffic\nUNION ALL\nSELECT \n  'Food Court' AS category, hour, food_court_head_count AS head_count\nFROM food_court_traffic\nUNION ALL\nSELECT \n  camera_location AS category, hour, demo_booth_head_count AS head_count\nFROM demo_booth_traffic\nORDER BY category, hour",
      "row_count": 96
    }
