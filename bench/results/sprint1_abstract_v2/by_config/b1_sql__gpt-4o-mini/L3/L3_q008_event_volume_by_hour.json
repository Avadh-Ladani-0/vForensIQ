    {
      "type": "sql_query",
      "sql": "WITH hourly_events AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour, COUNT(*) AS event_count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY hour\n)\nSELECT hour, event_count\nFROM hourly_events\nORDER BY hour",
