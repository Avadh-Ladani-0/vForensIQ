  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH event_counts AS (\n    SELECT strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n           COUNT(*) AS event_count,\n           SUM(head_count) AS total_head_count\n    FROM events\n    WHERE timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY hour\n),\npeak_hours AS (\n    SELECT hour, event_count, total_head_count,\n           RANK() OVER (ORDER BY event_count DESC) AS event_rank,\n           RANK() OVER (ORDER BY total_head_count DESC) AS head_count_rank\n    FROM event_counts\n)\nSELECT hour, event_count, total_head_count, 'event' AS type\nFROM peak_hours\nWHERE event_rank = 1 OR head_count_rank = 1\nUNION ALL\nSELECT timestamp_utc, head_count, NULL, 'crowd' AS type\nFROM events\nWHERE event_type = 'crowd' AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\nORDER BY hour",
      "row_count": 432002
    }
  ],
