  "citations": [
    {
      "type": "sql_query",
      "sql": "WITH crowd_data AS (\n    SELECT \n        camera_location,\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        SUM(head_count) AS total_head_count\n    FROM events\n    WHERE event_type = 'crowd' AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY camera_location, hour\n),\nentry_exit_data AS (\n    SELECT \n        camera_location,\n        strftime('%H', timestamp_epoch_s, 'unixepoch') AS hour,\n        COUNT(*) AS total_entries_exits\n    FROM events\n    WHERE event_type IN ('person_entry', 'person_exit', 'car_entry', 'car_exit') AND timestamp_utc >= '2025-12-08T00:00:00Z' AND timestamp_utc < '2025-12-09T00:00:00Z'\n    GROUP BY camera_location, hour\n)\nSELECT \n    'crowd' AS event_type,\n    camera_location,\n    hour,\n    total_head_count AS metric\nFROM crowd_data\nUNION ALL\nSELECT \n    'entry_exit' AS event_type,\n    camera_location,\n    hour,\n    total_entries_exits AS metric\nFROM entry_exit_data\nORDER BY camera_location, hour",
      "row_count": 192
    }
